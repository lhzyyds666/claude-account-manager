<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude 账号管家" Width="940" Height="620" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F7F6F3" Foreground="#1F1E1D" FontFamily="{StaticResource Ui}" FontSize="13"
        BorderBrush="#E2E0DA" BorderThickness="1" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Grid Margin="22,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="8" Background="#D97757">
          <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Claude 账号管家" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="BtnMin" Style="{StaticResource Chrome}" Content="&#xE921;"/>
        <Button x:Name="BtnClose" Style="{StaticResource Chrome}" Content="&#xE8BB;"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="22,4,22,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
          <Button x:Name="BtnAdd" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="＋  添加账号" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="账号" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtCurrent" Foreground="#6B6A66" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="List"/>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="会话同步" FontSize="15" FontWeight="SemiBold"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TxtSessions" Text="0" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="会话" Foreground="#6B6A66"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="TxtDirs" Text="0" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="账号目录" Foreground="#6B6A66"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="TxtLastSync" Foreground="#8A8984" FontSize="12" Margin="0,10,0,0"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnSync" Style="{StaticResource Btn}" Content="立即同步"/>
              <Button x:Name="BtnFolder" Grid.Column="2" Style="{StaticResource Btn}" Content="数据目录"/>
            </Grid>
            <Border Height="1" Background="#EFEDE8" Margin="0,16,0,6"/>
            <CheckBox x:Name="ChkRealtime" Style="{StaticResource Switch}" Content="实时同步" Margin="0,8,0,0"/>
            <CheckBox x:Name="ChkAuto" Style="{StaticResource Switch}" Content="开机自动启动" Margin="0,12,0,0"/>
            <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Content="关闭时最小化到托盘" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="活动" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="LogList" Foreground="#5E5D59" FontSize="12"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Background="#2B2A27" CornerRadius="10" Padding="18,10" Visibility="Collapsed">
      <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
    </Border>

    <Grid x:Name="Busy" Grid.RowSpan="2" Background="#B3F7F6F3" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
        <TextBlock x:Name="BusyText" FontSize="14"/>
      </Border>
    </Grid>
  </Grid>
</Window>
